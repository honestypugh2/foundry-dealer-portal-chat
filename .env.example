# ============================================================================
# JAYCO Dealer Portal - Environment Variables
# ============================================================================

# --- Azure AI Foundry ---
AZURE_AI_FOUNDRY_ENDPOINT=https://<your-ai-services>.cognitiveservices.azure.com/
AZURE_AI_PROJECT_ENDPOINT=https://<your-ai-services>.cognitiveservices.azure.com/api/projects/<your-project>
AZURE_AI_PROJECT_NAME=proj-mydealer-dev
AZURE_AI_PROJECT_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>

# --- Azure OpenAI (via Foundry AIServices) ---
AZURE_OPENAI_ENDPOINT=https://<your-ai-services>.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_INDEX_NAME=dealer-portal-docs
AZURE_SEARCH_API_KEY=your-key

# --- Azure Storage ---
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>
AZURE_STORAGE_CONTAINER_PORTAL=portal-docs
AZURE_STORAGE_CONTAINER_SHAREPOINT=sharepoint-docs
AZURE_STORAGE_CONTAINER_REVVER=revver-docs

# --- Azure Document Intelligence ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/

# --- Azure Application Insights ---
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-connection-string>

# --- Agentic Retrieval ---
AGENTIC_RETRIEVAL_ENABLED=true
AZURE_OPENAI_KB_MODEL_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_KB_MODEL_NAME=gpt-4.1-mini

# --- Response Tuning ---
MAX_CITATIONS=5
MAX_OUTPUT_TOKENS=4096

# --- Prod-only: Azure Key Vault ---
# AZURE_KEYVAULT_URI=https://<your-keyvault>.vault.azure.net/

# --- Prod-only: App Service ---
# AZURE_APP_SERVICE_URL=https://<your-app>.azurewebsites.net

# --- Prod-only: APIM Gateway ---
# AZURE_APIM_GATEWAY_URL=https://<your-apim>.azure-api.net

# --- Extraction Type ---
# "document_intelligence" (default) - Azure DI + manual chunking + embedding
# "integrated_vectorization" - AI Search indexer + skillset pipeline
EXTRACTION_TYPE=document_intelligence

# --- Agent Service ---
# "agent_framework" (default) - Agent Framework with FoundryChatClient
# "foundry" - Azure AI Foundry Agent Service with AI Search tool
AGENT_SERVICE=agent_framework

# --- Foundry Agent Connection ---
AI_SEARCH_PROJECT_CONNECTION_ID=<your-search-connection-id>

# --- Document Intelligence toggle ---
USE_AZURE_DOCUMENT_INTELLIGENCE=true

# --- Chunking ---
CHUNK_SIZE=2000
CHUNK_OVERLAP=200
CHUNK_CROSS_PAGE=false

# --- Vector Compression ---
# Scalar quantization (int8) reduces index size ~4x with rescoring for accuracy
SEARCH_USE_COMPRESSION=true

# --- Agent Persistence ---
PERSIST_FOUNDRY_AGENTS=false

# --- Application Settings ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Simulated Connectors (Demo mode) ---
SIMULATED_MODE=true
SHAREPOINT_SIM_DATA_PATH=./data/sharepoint_docs
REVVER_SIM_DATA_PATH=./data/revver_docs
